# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local Development (SQLite):
# DATABASE_URL="file:./dev.db"
#
# Production / Supabase PostgreSQL:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional Supabase API Keys (from Supabase Project Settings -> API)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# Optional AI Key for Quiz Generation
GEMINI_API_KEY=""

# AdMob Configuration
ADMOB_APP_ID="ca-app-pub-2168264599014117~2201830267"
ADMOB_PROD_BANNER_ID="ca-app-pub-2168264599014117/8986730461"
ADMOB_PROD_INTERSTITIAL_ID="ca-app-pub-2168264599014117/4522365131"
ADMOB_SSV_KEY="your_admob_ssv_secret"
